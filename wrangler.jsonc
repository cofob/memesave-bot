{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "memesave-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": { "directory": "./app/dist" },
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "ADMIN_ID": "1457408124",
    "PUBLIC_URL": "https://memereserve.cfb.wtf",
    // Batch images are presigned R2 S3 links (Vertex cannot fetch Cloudflare-hosted Worker URLs);
    // MEDIA_URL is the fallback host when the R2 API keys are not set.
    "MEDIA_URL": "https://memesave-bot.cofob.workers.dev",
    "R2_ACCOUNT_ID": "025464e503cbb7385dff88bd6d3c9128",
    "R2_BUCKET": "memesave-media",
    "BTCPAY_URL": "https://btcpay.cofob.dev",
    "BTCPAY_STORE_ID": "9rM3R2iTYdrsnqHkWiu9co4U79tLVLjAvusCLsvxQgoi",
    "BTCPAY_USDT": "Ethereum,Polygon,Plasma"
  },
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{ "pattern": "memereserve.cfb.wtf", "custom_domain": true }],
  "d1_databases": [
    { "binding": "DB", "database_name": "memesave", "database_id": "f5a303a3-e2ed-4e35-9e6f-0cf8abead35a", "migrations_dir": "migrations" }
  ],
  "vectorize": [{ "binding": "VECTORS", "index_name": "memesave-memes" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "memesave-media" }],
  "containers": [
    { "class_name": "ZipImporter", "image": "./container/Dockerfile", "instance_type": "standard-1", "max_instances": 5 },
    { "class_name": "DataExporter", "image": "./container/Dockerfile", "instance_type": "standard-1", "max_instances": 3 }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ZIP", "class_name": "ZipImporter" },
      { "name": "EXPORT", "class_name": "DataExporter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ZipImporter"] },
    { "tag": "v2", "new_sqlite_classes": ["DataExporter"] }
  ],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "memesave-jobs" }],
    "consumers": [
      { "queue": "memesave-jobs", "max_batch_size": 5, "max_batch_timeout": 1, "max_retries": 3, "max_concurrency": 10, "dead_letter_queue": "memesave-dlq" }
    ]
  }
}
